# Copy this file to .env and fill in your values
BOT_USERNAME=FriendlyBot
BOT_HOST=127.0.0.1
BOT_PORT=25565
BOT_VERSION=1.21.10
# Set to "microsoft" for online-mode servers, leave empty for offline
BOT_AUTH=
# Comma-separated list of player names the bot should protect
PROTECTED_PLAYERS=
# Protection radius (blocks)
PROTECTION_RADIUS=16
